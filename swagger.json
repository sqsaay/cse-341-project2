{
  "swagger": "2.0",
  "info": {
    "title": "Pet Owner API",
    "description": "API for managing owners and pets",
    "version": "1.0.0"
  },
  "host": "cse-341-project2-2szy.onrender.com/:3010",
  "basePath": "/",
  "schemes": ["https"],
  "paths": {
    "/owners/": {
      "get": {
        "tags": ["Owners"],
        "summary": "Get all owners",
        "produces": ["application/json"],
        "responses": {
          "200": { "description": "Owners returned" },
          "500": { "description": "Internal server error" }
        }
      },
      "post": {
        "tags": ["Owners"],
        "summary": "Create an owner",
        "consumes": ["application/json"],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/Owner" }
          }
        ],
        "responses": {
          "201": { "description": "Owner created" },
          "400": { "description": "Invalid owner" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/owners/{id}": {
      "get": {
        "tags": ["Owners"],
        "summary": "Get an owner by ID",
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "Owner returned" },
          "400": { "description": "Invalid ID" },
          "404": { "description": "Owner not found" },
          "500": { "description": "Internal server error" }
        }
      },
      "put": {
        "tags": ["Owners"],
        "summary": "Replace an owner",
        "consumes": ["application/json"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/Owner" }
          }
        ],
        "responses": {
          "204": { "description": "Owner updated" },
          "400": { "description": "Invalid request or ID" },
          "404": { "description": "Owner not found" },
          "500": { "description": "Internal server error" }
        }
      },
      "delete": {
        "tags": ["Owners"],
        "summary": "Delete an owner",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "204": { "description": "Owner deleted" },
          "400": { "description": "Invalid ID" },
          "404": { "description": "Owner not found" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/pets/": {
      "get": {
        "tags": ["Pets"],
        "summary": "Get all pets",
        "produces": ["application/json"],
        "responses": {
          "200": { "description": "Pets returned" },
          "500": { "description": "Internal server error" }
        }
      },
      "post": {
        "tags": ["Pets"],
        "summary": "Create a pet",
        "consumes": ["application/json"],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/Pet" }
          }
        ],
        "responses": {
          "201": { "description": "Pet created" },
          "400": { "description": "Invalid pet" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/pets/{id}": {
      "get": {
        "tags": ["Pets"],
        "summary": "Get a pet by ID",
        "produces": ["application/json"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": { "description": "Pet returned" },
          "400": { "description": "Invalid ID" },
          "404": { "description": "Pet not found" },
          "500": { "description": "Internal server error" }
        }
      },
      "put": {
        "tags": ["Pets"],
        "summary": "Replace a pet",
        "consumes": ["application/json"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/Pet" }
          }
        ],
        "responses": {
          "204": { "description": "Pet updated" },
          "400": { "description": "Invalid request or ID" },
          "404": { "description": "Pet not found" },
          "500": { "description": "Internal server error" }
        }
      },
      "delete": {
        "tags": ["Pets"],
        "summary": "Delete a pet",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "204": { "description": "Pet deleted" },
          "400": { "description": "Invalid ID" },
          "404": { "description": "Pet not found" },
          "500": { "description": "Internal server error" }
        }
      }
    }
  },
  "definitions": {
    "Owner": {
      "type": "object",
      "required": ["firstName", "lastName", "email"],
      "properties": {
        "firstName": { "type": "string", "example": "Samantha" },
        "lastName": { "type": "string", "example": "Salazar" },
        "email": { "type": "string", "example": "samantha@example.com" },
        "phone": { "type": "string", "example": "+1-555-1234" }
      }
    },
    "Pet": {
      "type": "object",
      "required": ["name", "species"],
      "properties": {
        "ownerId": { "type": "string" },
        "name": { "type": "string", "example": "Barnaby" },
        "species": { "type": "string", "example": "Dog" },
        "breed": { "type": "string", "example": "Golden Retriever" }
      }
    }
  }
}